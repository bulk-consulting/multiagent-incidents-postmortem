# Copiar para .env e ajustar (o .env não vai para o Git)

# PostgreSQL + pgvector (docker-compose.yml e scripts)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=incident_copilot
DATABASE_URL=postgresql://copilot:troque-esta-senha@localhost:5432/incident_copilot

# LLM no NVIDIA NIM (rag/llm.py); a chave se gera em https://build.nvidia.com/openai/gpt-oss-20b
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
