# Copiar para .env e ajustar (o .env não vai para o Git)

# PostgreSQL + pgvector (docker-compose.yml e scripts)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=incident_copilot
DATABASE_URL=postgresql://copilot:troque-esta-senha@localhost:5432/incident_copilot

# LLM no NVIDIA NIM (rag/llm.py); a chave se gera em https://build.nvidia.com/nvidia/nemotron-3.5-super-vl-120b-a12b (o openai/gpt-oss-20b saiu do NIM em 2026-11-18)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Chamadas por minuto ao LLM (o painel do build.nvidia.com mostra "Up to 40 rpm"; o limite real varia)
LLM_RPM=20
