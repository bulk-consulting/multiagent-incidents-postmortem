# ==========================================
# PYTHON ENVIRONMENTS
# ==========================================

# Keep the empty multiagent_env folder on GitHub
/multiagent_env/*
!/multiagent_env/.gitkeep

# Ignore other virtual environments
**/.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/


# ==========================================
# SECRETS AND LOCAL SETTINGS
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ==========================================
# TEMPORARY FILES
# ==========================================

*.log
*.tmp
*.swp

verificacao_git.txt
arquivos_preparados.txt


# ==========================================
# EDITORS AND OPERATING SYSTEM
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db


# ==========================================
# RAW DATASETS (E1.3)
# ==========================================

/data/raw/
# ==========================================
# LOCAL SETTINGS (Claude Code and Streamlit)
# ==========================================

.claude/
.streamlit/
