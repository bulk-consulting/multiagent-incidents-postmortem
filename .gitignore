# ==========================================
# AMBIENTES PYTHON
# ==========================================

# Preservar a pasta multiagent_env vazia no GitHub
/multiagent_env/*
!/multiagent_env/.gitkeep

# Ignorar outros ambientes virtuais
**/.venv/
venv/

# Cache Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/


# ==========================================
# SEGREDOS E CONFIGURAÇÕES LOCAIS
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ==========================================
# ARQUIVOS TEMPORÁRIOS
# ==========================================

*.log
*.tmp
*.swp

verificacao_git.txt
arquivos_preparados.txt


# ==========================================
# EDITORES E SISTEMA OPERACIONAL
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db


# ==========================================
# DATASETS BRUTOS (E1.3)
# ==========================================

/data/raw/revisao/
ingestion/fichas/prompts_prontos/
/revisao/

# vetores gerados pelo ingestion/corpus/gerar_embeddings.py (recriáveis)
ingestion/corpus/embeddings/*/*.npy
# os vetores do modelo escolhido vão para o git: quem clonar não precisa de GPU para rodar o pipeline
!ingestion/corpus/embeddings/qwen3/*.npy

# ==========================================
# MATERIAL DE ESTUDO (livros em PDF: não vão para o repositório)
# ==========================================

/*.pdf

# notas de estudo pessoais (ficam só na máquina local)
/docs/estudo/
