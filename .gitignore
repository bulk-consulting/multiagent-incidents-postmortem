# ==========================================
# AMBIENTES PYTHON
# ==========================================

# Preservar a pasta multiagent_env vazia no GitHub
/multiagent_env/*
!/multiagent_env/.gitkeep

# Ignorar outros ambientes virtuais
**/.venv/
venv/

# Cache Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/


# ==========================================
# SEGREDOS E CONFIGURAÇÕES LOCAIS
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ==========================================
# ARQUIVOS TEMPORÁRIOS
# ==========================================

*.log
*.tmp
*.swp

verificacao_git.txt
arquivos_preparados.txt


# ==========================================
# EDITORES E SISTEMA OPERACIONAL
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db


# ==========================================
# DATASETS BRUTOS (E1.3)
# ==========================================

/data/raw/revisao/
ingestion/fichas/prompts_prontos/
/revisao/
